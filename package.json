{
  "name": "seocron",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "overrides": {
    "nanoid": "^3.3.17"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:chromium": "npm run build && playwright test --project=chromium",
    "test:smoke": "playwright test e2e/smoke.spec.ts --project=chromium",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality:budget": "node scripts/check-build-budget.mjs",
    "quality:lighthouse": "node scripts/run-lighthouse.mjs",
    "quality:summary": "node scripts/write-quality-summary.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build && npm run quality:budget",
    "verify:full": "npm run verify && playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "dseg": "^0.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
